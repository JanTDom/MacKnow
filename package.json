{
  "name": "macknow",
  "version": "1.0.0",
  "private": true,
  "description": "MacKnow – osobisty przewodnik po MacBooku dla Małgorzaty",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter @macknow/web run build && pnpm --filter @macknow/desktop run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "pnpm -r run typecheck && node scripts/lint-pl.mjs",
    "lint:pl": "node scripts/lint-pl.mjs",
    "dev:web": "pnpm --filter @macknow/web dev",
    "dev:desktop": "pnpm --filter @macknow/desktop dev",
    "dist:desktop": "pnpm --filter @macknow/desktop dist"
  },
  "browserslist": [
    "safari >= 11",
    "chrome >= 70"
  ],
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@12.15.0"
}
