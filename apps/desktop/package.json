{
  "name": "@macknow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MacKnow – aplikacja na Maca dla Małgorzaty",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "dist": "pnpm run build && electron-builder --mac dmg --x64 --arm64"
  },
  "dependencies": {
    "@macknow/core": "workspace:*",
    "@macknow/missions": "workspace:*",
    "@macknow/ui": "workspace:*",
    "chokidar": "^3.6.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "electron": "26.6.10",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3"
  }
}
