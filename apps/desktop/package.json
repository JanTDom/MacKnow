{
  "name": "@macknow/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MacKnow – osobisty przewodnik po MacBooku dla Małgorzaty",
  "author": "MacKnow",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && electron .",
    "dist:x64": "pnpm run build && electron-builder --mac dmg --x64 --config.mac.artifactName='MacKnow-${version}-Intel-x64.${ext}'",
    "dist:arm64": "pnpm run build && electron-builder --mac dmg --arm64 --config.mac.artifactName='MacKnow-${version}-AppleSilicon-arm64.${ext}'",
    "dist:universal": "pnpm run build && electron-builder --mac dmg --universal --config.mac.artifactName='MacKnow-${version}-Universal.${ext}'",
    "dist": "pnpm run dist:x64 && pnpm run dist:arm64"
  },
  "build": {
    "appId": "pl.malgorzata.macknow",
    "productName": "MacKnow",
    "copyright": "Copyright © 2026 MacKnow dla Małgorzaty",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web-out"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "10.13.0",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "title": "MacKnow – Instalator (${arch})"
    }
  },
  "dependencies": {
    "@macknow/core": "workspace:*",
    "@macknow/missions": "workspace:*",
    "@macknow/ui": "workspace:*",
    "chokidar": "^3.6.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "electron": "26.6.10",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3"
  }
}
